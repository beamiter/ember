 /// Short for `Result<T, eframe::Error>`.
 pub type Result<T = (), E = Error> = std::result::Result<T, E>;
+
+// Benchmark-only passive instrumentation. Never ship this overlay.
+static EMBER_BENCHMARK_STARTED: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+static EMBER_BENCHMARK_REPORTED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static EMBER_PHASE_TOTALS: [std::sync::atomic::AtomicU64; 3] = [const { std::sync::atomic::AtomicU64::new(0) }; 3];
+static EMBER_PHASE_COUNTS: [std::sync::atomic::AtomicU64; 3] = [const { std::sync::atomic::AtomicU64::new(0) }; 3];
+static EMBER_PHASE_NOT_QUIET: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+#[doc(hidden)]
+pub fn __ember_benchmark_start(started: std::time::Instant) {
+    let _ = EMBER_BENCHMARK_STARTED.set(started);
+}
+
+#[doc(hidden)]
+pub fn __ember_benchmark_quiet(quiet: bool) {
+    if !quiet && !EMBER_BENCHMARK_REPORTED.load(std::sync::atomic::Ordering::Relaxed) {
+        EMBER_PHASE_NOT_QUIET.store(true, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+
+#[doc(hidden)]
+pub struct __EmberPhaseGuard {
+    started: Option<std::time::Instant>,
+    phase: usize,
+}
+
+impl __EmberPhaseGuard {
+    #[doc(hidden)]
+    pub fn new(phase: usize) -> Self {
+        Self {
+            started: (!EMBER_BENCHMARK_REPORTED.load(std::sync::atomic::Ordering::Relaxed)).then(std::time::Instant::now),
+            phase,
+        }
+    }
+}
+
+impl Drop for __EmberPhaseGuard {
+    fn drop(&mut self) {
+        if let Some(started) = self.started {
+            let elapsed = started.elapsed().as_nanos();
+            // Overflow rejects the experiment through its budget check.
+            let elapsed = u64::try_from(elapsed).unwrap_or(u64::MAX);
+            EMBER_PHASE_TOTALS[self.phase].fetch_add(elapsed, std::sync::atomic::Ordering::Relaxed);
+            EMBER_PHASE_COUNTS[self.phase].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+}
+
+pub(crate) fn ember_benchmark_first_painted_frame() {
+    use std::io::Write as _;
+    use std::sync::atomic::Ordering;
+    if let Some(started) = EMBER_BENCHMARK_STARTED.get() {
+        if !EMBER_BENCHMARK_REPORTED.swap(true, Ordering::Relaxed) {
+            // Sample before any diagnostic I/O; output cannot alter these timings.
+            let elapsed_ns = started.elapsed().as_nanos();
+            let mut stderr = std::io::stderr().lock();
+            let _ = writeln!(stderr, "EMBER_BENCHMARK_MAIN_TO_FIRST_PAINT_NS={elapsed_ns}");
+            for phase in 0..3 {
+                let total = EMBER_PHASE_TOTALS[phase].load(Ordering::Relaxed);
+                let count = EMBER_PHASE_COUNTS[phase].load(Ordering::Relaxed);
+                let _ = writeln!(stderr, "EMBER_DIRECT_PHASE_{phase}_NS={total} COUNT={count}");
+            }
+            let quiet = u8::from(!EMBER_PHASE_NOT_QUIET.load(Ordering::Relaxed));
+            let _ = writeln!(stderr, "EMBER_DIRECT_QUIET={quiet}");
+        }
+    }
+}
