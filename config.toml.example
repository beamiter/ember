# ember configuration
# Omitted values use the defaults of the installed binary, so upgrades pick
# up the current defaults without duplicating them in this template.
# The installer tracks template fields in .config.toml.installed-defaults.
# Only changes to the installed template fields trigger config.toml.backup.*.
# Existing configurations without an installation record are adopted unchanged.
# Restore selected custom settings from that private backup as needed.
# Use scripts/install.sh --no-config to always keep your existing configuration.
# Example customizations:
# Main content and sidebar/top-bar sizes are independent (logical points).
# An older config without ui_font_size inherits font_size once when loaded.
# font_size = 14.0
# ui_font_size = 14.0
# Shared Eva is enabled by default; JWM starts the local coordinator.
# Set false and restart to disable Shared Eva.
eva_companion_enabled = true
# Legacy local organism is only used with Shared Eva disabled.
# ascii_organism_enabled = false
# terminal_mode = "block"

# Drag the navigation/inspector edge grips to resize; double-click resets the
# adaptive default. Widths use logical points and are saved when a drag ends.
# sidebar_width = 312.0   # 180..480; omitted keeps responsive 220/232/252 defaults
# inspector_width = 390.0 # 260..520; compact windows preserve this preference


# Vim uses the native GUI buffer by default. Extra workbench panels are opt-in.
# These settings apply only to explicitly opened Vim editors, not shell tabs.
# [vim9]
# native_buffer = true
# toolbar = false
# buffer_tabs = false
# status_bar = false
# project_panel = false
# tool_panel = false
# Search/Build commands can still open a temporary tool row; Escape closes it.
